<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Benedito Digital"
    Manufacturer="Projeto Benedito Digital"
    Version="$(ProductVersion)"
    UpgradeCode="B03D65D8-8E74-4F28-9149-4EBBF61A8437"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation Description="Software aberto de restauração audiovisual" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Benedito Digital já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Benedito Digital" />
    </StandardDirectory>

    <Files Include="!(bindpath.AppSource)\**" Directory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Benedito Digital">
        <Component Id="ApplicationShortcut" Guid="D4B9A03B-C1A2-4B24-8537-E9D7273D45E5">
          <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Benedito Digital"
            Description="Restauração audiovisual local"
            Target="[INSTALLFOLDER]Benedito Digital.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKLM"
            Key="Software\Benedito Digital"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Benedito Digital" Level="1">
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
